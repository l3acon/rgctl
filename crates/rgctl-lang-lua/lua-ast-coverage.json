{
  "grammar": "tree-sitter-lua@0.5.0",
  "handlers": {
    "arguments": "Skip",
    "assignment_statement": "Symbol",
    "attribute": "Skip",
    "binary_expression": "Skip",
    "block": "Skip",
    "bracket_index_expression": "Skip",
    "break_statement": "Skip",
    "chunk": "Skip",
    "comment": "Skip",
    "comment_content": "Skip",
    "do_statement": "CfgStatement",
    "dot_index_expression": "Skip",
    "else_statement": "Skip",
    "elseif_statement": "Skip",
    "empty_statement": "Skip",
    "escape_sequence": "Skip",
    "expression_list": "Skip",
    "false": "Skip",
    "field": "Skip",
    "for_generic_clause": "Skip",
    "for_numeric_clause": "Skip",
    "for_statement": "CfgStatement",
    "function_call": "Relation",
    "function_declaration": "Symbol",
    "function_definition": "Symbol",
    "goto_statement": "Skip",
    "hash_bang_line": "Skip",
    "identifier": "Skip",
    "if_statement": "CfgStatement",
    "implicit_variable_declaration": "Skip",
    "label_statement": "Skip",
    "method_index_expression": "Skip",
    "nil": "Skip",
    "number": "Skip",
    "parameters": "Skip",
    "parenthesized_expression": "Skip",
    "repeat_statement": "CfgStatement",
    "return_statement": "CfgStatement",
    "string": "Skip",
    "string_content": "Skip",
    "table_constructor": "Skip",
    "true": "Skip",
    "unary_expression": "Skip",
    "vararg_expression": "Skip",
    "variable_declaration": "Skip",
    "variable_list": "Skip",
    "while_statement": "CfgStatement"
  },
  "language": "lua"
}
